{
  "name": "web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "build": "run-p check-types \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "check-types": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/query-persist-client-core": "^5.100.14",
    "@tanstack/vue-query": "^5.100.14",
    "@tanstack/vue-query-devtools": "^6.1.33",
    "@tanstack/vue-virtual": "^3.13.26",
    "data-access": "workspace:*",
    "tailwindcss": "^4.3.0",
    "ui": "workspace:*",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.2",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "npm-run-all2": "^6.1.2",
    "tsconfig": "workspace:*",
    "typescript": "5.5.4",
    "vite": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "^2.0.4"
  }
}
