{
  "name": "with-vue-nuxt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=e2e-tests",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.16",
    "typescript": "5.5.4",
    "vue-tsc": "^2.0.4"
  },
  "packageManager": "pnpm@8.15.6"
}
